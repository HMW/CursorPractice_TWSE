@startuml TWSE_APP_Architecture

skinparam classAttributeIconSize 0
skinparam linetype ortho

package "UI Layer (Presentation)" {
    
    package "Screens (Composables)" {
        class LaunchScreen <<@Composable>> {
            + viewModel: LaunchViewModel
            + onNavigateToMain()
        }
        
        class IndustryCategoryScreen <<@Composable>> {
            + viewModel: IndustryCategoryViewModel
            + onNavigateToCompanyList(industry: Industry)
            + onNavigateToWatchlist()
        }
        
        class CompanyListScreen <<@Composable>> {
            + viewModel: CompanyListViewModel
            + industry: Industry
            + onNavigateToCompanyDetail(company: Company)
        }
        
        class CompanyDetailScreen <<@Composable>> {
            + viewModel: CompanyDetailViewModel
            + company: Company
            + onNavigateBack()
        }
        
        class WatchlistScreen <<@Composable>> {
            + viewModel: WatchlistViewModel
            + onNavigateBack()
            + onNavigateToCompanyDetail(watchlistItem: WatchlistItem)
        }
    }
    
    package "ViewModels" {
        class LaunchViewModel {
            - getCompaniesUseCase: GetCompaniesUseCase
            - getIndustriesUseCase: GetIndustriesUseCase
            - uiState: StateFlow<LaunchUiState>
            + initializeData()
        }
        
        class IndustryCategoryViewModel {
            - getIndustriesUseCase: GetIndustriesUseCase
            - uiState: StateFlow<UiState<List<Industry>>>
            + loadIndustries()
        }
        
        class CompanyListViewModel {
            - getCompaniesByIndustryUseCase: GetCompaniesByIndustryUseCase
            - uiState: StateFlow<UiState<List<Company>>>
            + loadCompaniesByIndustry(industry: Industry)
        }
        
        class CompanyDetailViewModel {
            - addToWatchlistUseCase: AddToWatchlistUseCase
            - removeFromWatchlistUseCase: RemoveFromWatchlistUseCase
            - isInWatchlistUseCase: IsInWatchlistUseCase
            - uiState: StateFlow<CompanyDetailUiState>
            + loadCompanyDetail(company: Company)
        }
        
        class WatchlistViewModel {
            - getWatchlistUseCase: GetWatchlistUseCase
            - removeFromWatchlistUseCase: RemoveFromWatchlistUseCase
            - uiState: StateFlow<WatchlistUiState>
            + loadWatchlist()
        }
    }
    
    package "UI State" {
        class LaunchUiState {
            + Initial
            + Loading
            + NavigateToMain
            + Error(message: String)
        }
        
        class CompanyDetailUiState {
            + Initial
            + Loading
            + Success(company: Company, showWatchlistDialog: Boolean)
            + Error(message: String)
        }
        
        class WatchlistUiState {
            + Initial
            + Loading
            + Success(watchlist: List<WatchlistItem>)
            + Error(message: String)
        }
    }
    
    
    package "Navigation" {
        class TwseNavigation {
            + LaunchRoute
            + IndustryCategoryRoute
            + CompanyListRoute
            + CompanyDetailRoute
            + WatchlistRoute
        }
    }
    
    package "UI Components" {
        class WebsiteLink <<@Composable>> {
            + url: String
            + displayText: String?
            + onClick()
        }
        
        class SimpleWebsiteLink <<@Composable>> {
            + url: String
            + displayText: String
            + onClick()
        }
    }
}

package "Domain Layer" {
    
    package "Models" {
        class Industry {
            + code: String
            + name: String
            + companyCount: Int
        }
        
        class Company {
            + 出表日期: String
            + 公司代號: String
            + 公司名稱: String
            + 公司簡稱: String
            + 外國企業註冊地國: String
            + 產業別: String
            + 住址: String
            + 營利事業統一編號: String
            + 董事長: String
            + 總經理: String
            + 發言人: String
            + 發言人職稱: String
            + 代理發言人: String
            + 總機電話: String
            + 成立日期: String
            + 上市日期: String
            + 普通股每股面額: String
            + 實收資本額: String
            + 已發行普通股數或TDR原股發行股數: String
            + 私募股數: String
            + 特別股: String
            + 編製財務報告類型: String
            + 股票過戶機構: String
            + 過戶電話: String
            + 過戶地址: String
            + 簽證會計師事務所: String
            + 簽證會計師1: String
            + 簽證會計師2: String
            + 英文簡稱: String
            + 英文通訊地址: String
            + 傳真機號碼: String
            + 電子郵件信箱: String
            + 網址: String
            + getIndustryCode(): String
            + getIndustryName(): String
        }
        
        class WatchlistItem {
            + companyCode: String
            + companyName: String
            + companyShortName: String
            + industryCode: String
            + industryName: String
            + addedDate: String
            + getDisplayName(): String
            + getFullDisplayName(): String
        }
    }
    
    package "Use Cases" {
        class GetCompaniesUseCase {
            - repository: TwseRepository
            + operator invoke(): Result<List<Company>>
        }
        
        class GetIndustriesUseCase {
            - repository: TwseRepository
            + operator invoke(): Result<List<Industry>>
        }
        
        class GetCompaniesByIndustryUseCase {
            - repository: TwseRepository
            + operator invoke(industryCode: String): Result<List<Company>>
        }
        
        class GetWatchlistUseCase {
            - repository: WatchlistRepository
            + operator invoke(): Result<List<WatchlistItem>>
        }
        
        class AddToWatchlistUseCase {
            - repository: WatchlistRepository
            + operator invoke(company: Company): Result<Unit>
        }
        
        class RemoveFromWatchlistUseCase {
            - repository: WatchlistRepository
            + operator invoke(companyCode: String): Result<Unit>
        }
        
        class IsInWatchlistUseCase {
            - repository: WatchlistRepository
            + operator invoke(companyCode: String): Result<Boolean>
        }
    }
    
    package "Repository Interface" {
        interface TwseRepository {
            + getCompanies(): Result<List<Company>>
            + getIndustries(): Result<List<Industry>>
            + getCompaniesByIndustry(industryCode: String): Result<List<Company>>
        }
        
        interface WatchlistRepository {
            + getWatchlist(): Result<List<WatchlistItem>>
            + addToWatchlist(company: Company): Result<Unit>
            + removeFromWatchlist(companyCode: String): Result<Unit>
            + isInWatchlist(companyCode: String): Result<Boolean>
        }
    }
}

package "Data Layer" {
    
    package "Repository Implementation" {
        class TwseRepositoryImpl {
            - remoteDataSource: TwseRemoteDataSource
            - localDataSource: TwseLocalDataSource
            + getCompanies(): Result<List<Company>>
            + getIndustries(): Result<List<Industry>>
            + getCompaniesByIndustry(industryCode: String): Result<List<Company>>
        }
        
        class WatchlistRepositoryImpl {
            - localDataSource: WatchlistLocalDataSource
            + getWatchlist(): Result<List<WatchlistItem>>
            + addToWatchlist(company: Company): Result<Unit>
            + removeFromWatchlist(companyCode: String): Result<Unit>
            + isInWatchlist(companyCode: String): Result<Boolean>
        }
    }
    
    package "Remote Data Source" {
        interface TwseRemoteDataSource {
            + fetchCompanies(): List<CompanyDto>
        }
        
        class TwseRemoteDataSourceImpl {
            - apiService: TwseApiService
            + fetchCompanies(): List<CompanyDto>
        }
        
        interface TwseApiService {
            + @GET("/opendata/t187ap03_P")
            + getCompanies(): List<CompanyDto>
        }
        
        class CompanyDto {
            + 出表日期: String
            + 公司代號: String
            + 公司名稱: String
            + 公司簡稱: String
            + 產業別: String
            + ... (其他欄位)
        }
    }
    
    package "Local Data Source" {
        interface TwseLocalDataSource {
            + getCompanies(): Flow<List<CompanyEntity>>
            + getIndustries(): Flow<List<IndustryEntity>>
            + getCompaniesByIndustry(industryCode: String): Flow<List<CompanyEntity>>
            + insertCompanies(companies: List<CompanyEntity>)
            + clearAll()
        }
        
        class TwseLocalDataSourceImpl {
            - dao: TwseDao
            + getCompanies(): Flow<List<CompanyEntity>>
            + getIndustries(): Flow<List<IndustryEntity>>
            + getCompaniesByIndustry(industryCode: String): Flow<List<CompanyEntity>>
            + insertCompanies(companies: List<CompanyEntity>)
            + clearAll()
        }
        
        interface WatchlistLocalDataSource {
            + getWatchlistItems(): Flow<List<WatchlistItemEntity>>
            + insertWatchlistItem(item: WatchlistItemEntity)
            + deleteWatchlistItem(companyCode: String)
            + isWatchlistItemExists(companyCode: String): Boolean
        }
        
        class WatchlistLocalDataSourceImpl {
            - dao: WatchlistDao
            + getWatchlistItems(): Flow<List<WatchlistItemEntity>>
            + insertWatchlistItem(item: WatchlistItemEntity)
            + deleteWatchlistItem(companyCode: String)
            + isWatchlistItemExists(companyCode: String): Boolean
        }
        
        interface TwseDao {
            + @Query("SELECT * FROM companies")
            + getAllCompanies(): Flow<List<CompanyEntity>>
            + @Query("SELECT DISTINCT 產業別 as code, 產業別 as name, COUNT(*) as companyCount FROM companies GROUP BY 產業別")
            + getIndustries(): Flow<List<IndustryEntity>>
            + @Query("SELECT * FROM companies WHERE 產業別 = :industryCode")
            + getCompaniesByIndustry(industryCode: String): Flow<List<CompanyEntity>>
            + @Insert(onConflict = OnConflictStrategy.REPLACE)
            + insertAll(companies: List<CompanyEntity>)
            + @Query("DELETE FROM companies")
            + clearAll()
        }
        
        interface WatchlistDao {
            + @Query("SELECT * FROM watchlist_items ORDER BY addedDate DESC")
            + getAllWatchlistItems(): Flow<List<WatchlistItemEntity>>
            + @Insert(onConflict = OnConflictStrategy.REPLACE)
            + insertWatchlistItem(item: WatchlistItemEntity)
            + @Query("DELETE FROM watchlist_items WHERE companyCode = :companyCode")
            + deleteWatchlistItem(companyCode: String)
            + @Query("SELECT EXISTS(SELECT 1 FROM watchlist_items WHERE companyCode = :companyCode)")
            + isWatchlistItemExists(companyCode: String): Boolean
        }
        
        class TwseDatabase {
            + abstract twseDao(): TwseDao
            + abstract watchlistDao(): WatchlistDao
        }
        
        class CompanyEntity {
            + @PrimaryKey 公司代號: String
            + 出表日期: String
            + 公司名稱: String
            + 公司簡稱: String
            + 產業別: String
            + ... (其他欄位)
        }
        
        class IndustryEntity {
            + code: String
            + name: String
            + companyCount: Int
        }
        
        class WatchlistItemEntity {
            + @PrimaryKey companyCode: String
            + companyName: String
            + companyShortName: String
            + industryCode: String
            + industryName: String
            + addedDate: String
        }
    }
    
    package "Mappers" {
        class CompanyMapper {
            + {static} toEntity(dto: CompanyDto): CompanyEntity
            + {static} toDomain(entity: CompanyEntity): Company
            + {static} toDomain(dto: CompanyDto): Company
        }
        
        class IndustryMapper {
            + {static} toDomain(entity: IndustryEntity): Industry
        }
        
        class WatchlistMapper {
            + {static} toEntity(company: Company): WatchlistItemEntity
            + {static} toDomain(entity: WatchlistItemEntity): WatchlistItem
            + {static} toDomainList(entities: List<WatchlistItemEntity>): List<WatchlistItem>
        }
    }
    
    package "Utils" {
        class UrlUtils {
            + {static} isValidUrl(urlString: String): Boolean
            + {static} formatUrl(urlString: String): String?
            + {static} getDisplayName(urlString: String): String
            + {static} getSecureUrl(urlString: String): String?
        }
        
        class BrowserUtils {
            + {static} openUrlInBrowser(context: Context, urlString: String): Boolean
            + {static} openSecureUrlInBrowser(context: Context, urlString: String): Boolean
            + {static} canOpenUrl(context: Context, urlString: String): Boolean
        }
    }
}

package "Dependency Injection" {
    class AppModule {
        + provideTwseRepository()
        + provideContext()
    }
    
    class NetworkModule {
        + provideOkHttpClient()
        + provideRetrofit()
        + provideTwseApiService()
    }
    
    class DatabaseModule {
        + provideTwseDatabase()
        + provideTwseDao()
    }
}

